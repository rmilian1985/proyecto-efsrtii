# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN A BASE DE DATOS Y SERVIDOR
# Distribuciones y Servicios del Norte S.A.C. - Cibertec EFSRT II
# ==============================================================================

# Puerto de la API REST
PORT=4000

# Parámetros de SQL Server (Local o en la Nube / Azure / VPS)
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro123*
DB_NAME=BD_DistribucionesNorte
DB_PORT=1433

# Opciones de cifrado SSL
# Para SQL Server Local Express o Developer: false
# Para Azure SQL Database en la nube: true
DB_ENCRYPT=false

# Confiar en certificado del servidor autofirmado (true en desarrollo y la mayoría de nubes)
DB_TRUST_SERVER_CERTIFICATE=true
