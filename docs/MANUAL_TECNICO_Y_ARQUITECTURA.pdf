(CREATE PROCEDURE sp_ProcesarPedidoInstitucional) Tj
T* (    @IdCliente INT, @IdProducto INT, @CantidadSolicitada INT,) Tj
T* (    @Resultado INT OUTPUT, @Mensaje VARCHAR\(200\) OUTPUT) Tj
T* (AS BEGIN) Tj
T* (    SET NOCOUNT ON;) Tj
T* (    BEGIN TRANSACTION;) Tj
T* (    BEGIN TRY) Tj
T* (        -- Bloqueo pesimista de fila para evitar condiciones de carrera \(Race Conditions\):) Tj
T* (        SELECT @StockActual = StockActual, @PrecioU = PrecioUnitario) Tj
T* (        FROM Producto WITH \(UPDLOCK\) WHERE IdProducto = @IdProducto;) Tj
T* () Tj
T* (        IF @StockActual < @CantidadSolicitada BEGIN) Tj
T* (            ROLLBACK TRANSACTION;) Tj
T* (            SET @Resultado = 0; SET @Mensaje = 'Stock insuficiente para abastecer el pedido.';) Tj
T* (            RETURN;) Tj
T* (        END;) Tj
T* (        -- Inserción de cabecera de Pedido, Detalle y Descuento de Stock en Producto...) Tj
T* (        COMMIT TRANSACTION;) Tj
T* (        SET @Resultado = 1; SET @Mensaje = 'Pedido procesado con éxito.';) Tj
T* (    END TRY) Tj
T* (    BEGIN CATCH) Tj
T* (        ROLLBACK TRANSACTION;) Tj
T* (        SET @Resultado = -1; SET @Mensaje = ERROR_MESSAGE\(\);) Tj
T* (    END CATCH) Tj
T* (END;) Tj
